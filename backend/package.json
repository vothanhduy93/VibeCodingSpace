{
  "name": "vibespace-backend",
  "version": "1.0.0",
  "description": "Fastify + Prisma Backend for VibeSpace Cloud Sync and Auth",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
