    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^6.4.1",
    "dotenv": "^18.0.0",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "prisma": "^6.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
