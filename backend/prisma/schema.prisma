generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String?
  avatar       String?
  authProvider String         @default("magic-link") // "google" | "magic-link"
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  todos        TodoItem[]
  pomodoroLogs PomodoroLog[]
  settings     UserSettings?

  @@map("users")
}

model TodoItem {
  id        String    @id // Client-generated UUID or server UUID
  userId    String
  text      String
  completed Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete for delta sync

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@map("todo_items")
}

model PomodoroLog {
  id          String   @id @default(uuid())
  userId      String
  duration    Int      // Duration in seconds (e.g. 1500 = 25m)
  mode        String   @default("pomodoro") // "pomodoro" | "shortBreak" | "longBreak"
  completedAt DateTime @default(now())
  date        String   // "YYYY-MM-DD" for fast heatmap grouping

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("pomodoro_logs")
}

model UserSettings {
  id                 String   @id @default(uuid())
  userId             String   @unique
  wallpaper          String   @default("lofi-cafe")
  customWallpaperUrl String?
  soundVolumes       String   @default("{}") // JSON string of sound mixer volumes
  language           String   @default("vi")
  pomodoroSettings   String   @default("{\"workTime\":25,\"shortBreak\":5,\"longBreak\":15}")
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model MagicLinkToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
  @@map("magic_link_tokens")
}
